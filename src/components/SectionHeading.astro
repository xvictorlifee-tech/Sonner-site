---
interface Props {
  number?: string;
  label: string;
  class?: string;
}
const { number, label, class: className = '' } = Astro.props;
---

<div class:list={['flex items-center gap-4', className]} data-reveal>
  <p class="eyebrow">{number && <span>{number} — </span>}{label}</p>
  <span class="h-px flex-1 bg-current opacity-25" aria-hidden="true"></span>
</div>
