---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Button from './Button.astro';
import { nav, whatsappLink, contact } from '../data/site';
import { cleanPath } from '../data/url';

const current = cleanPath(Astro.url.pathname);
---

<header class="site-header fixed inset-x-0 top-0 z-40 px-3 pt-3 text-preto sm:px-6 sm:pt-4" data-header>
  <div class="glass-bar mx-auto flex h-16 max-w-[84rem] items-center justify-between gap-6 rounded-full pr-2 pl-6 sm:h-[4.5rem] sm:pr-2.5 sm:pl-8">
    <a href="/" class="-m-2 p-2" aria-label="Sonner — página inicial">
      <Logo variant="reduzida" class="w-[112px] sm:w-[128px]" label="Sonner" />
    </a>

    <nav aria-label="Principal" class="hidden md:block">
      <ul class="flex items-center gap-10 text-sm font-medium">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link relative py-2"
                aria-current={current === item.href ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <div class="header-cta hidden md:block">
        <Button href={whatsappLink()} icon="whatsapp" external>Fale com a gente</Button>
      </div>
      <button
        type="button"
        class="menu-btn inline-flex size-12 items-center justify-center rounded-full md:hidden"
        aria-label="Abrir menu"
        aria-haspopup="dialog"
        data-menu-open
      >
        <Icon name="menu" class="size-7" />
      </button>
    </div>
  </div>

  <dialog
    class="mobile-menu m-0 h-dvh max-h-none w-full max-w-none bg-preto p-0 text-branco backdrop:bg-transparent"
    aria-label="Menu"
    data-menu
  >
    <div class="container-site flex h-full flex-col">
      <div class="flex h-18 items-center justify-between sm:h-20">
        <a href="/" aria-label="Sonner — página inicial" class="text-amarelo">
          <Logo variant="reduzida" class="w-[112px]" label="Sonner" />
        </a>
        <button type="button" class="-mr-2 inline-flex size-12 items-center justify-center text-amarelo" aria-label="Fechar menu" data-menu-close>
          <Icon name="close" class="size-7" />
        </button>
      </div>
      <nav aria-label="Menu móvel" class="mt-10 flex-1">
        <ul class="space-y-2">
          <li><a href="/" class="title block py-2 text-5xl" aria-current={current === '/' ? 'page' : undefined}>Início</a></li>
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class="title block py-2 text-5xl" aria-current={current === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="space-y-6 pb-10">
        <Button href={whatsappLink()} variant="light" icon="whatsapp" size="lg" external class="w-full">Fale com a gente</Button>
        <p class="text-sm text-branco/70">{contact.email}</p>
      </div>
    </div>
  </dialog>
</header>

<style>
  .h-18 { height: 4.5rem; }

  /* Barra de vidro: só tons da paleta (branco e preto) com transparência. */
  .glass-bar {
    position: relative;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.3));
    -webkit-backdrop-filter: blur(28px) saturate(170%);
    backdrop-filter: blur(28px) saturate(170%);
    border: 1px solid rgb(255 255 255 / 0.6);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.75),
      inset 0 -1px 0 rgb(28 25 4 / 0.06),
      0 12px 32px -14px rgb(28 25 4 / 0.35);
    transition: background 0.4s, border-color 0.4s, box-shadow 0.4s, color 0.4s;
  }
  .menu-btn { background: rgb(28 25 4 / 0.08); }

  /* Sobre seções escuras (preto e verde noite), o vidro escurece e o texto vira claro. */
  .site-header.is-dark { color: var(--color-branco); }
  .site-header.is-dark .glass-bar {
    background: linear-gradient(180deg, rgb(28 25 4 / 0.55), rgb(28 25 4 / 0.35));
    border-color: rgb(255 255 255 / 0.14);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.12),
      0 12px 32px -14px rgb(0 0 0 / 0.6);
  }
  .site-header.is-dark .glass-bar > a:first-child { color: var(--color-amarelo); }
  .site-header.is-dark .menu-btn { background: rgb(255 255 255 / 0.1); }
  .site-header.is-dark .header-cta :global(a) {
    background: var(--color-amarelo);
    color: var(--color-preto);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .glass-bar { background: rgb(255 255 255 / 0.92); }
    .site-header.is-dark .glass-bar { background: rgb(28 25 4 / 0.92); }
  }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.4s var(--ease-out-soft);
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .mobile-menu[open] { animation: menu-in 0.35s var(--ease-out-soft); }
  .mobile-menu [aria-current='page'] { color: var(--color-amarelo); }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-1rem); }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  openBtn?.addEventListener('click', () => menu?.showModal());
  closeBtn?.addEventListener('click', () => menu?.close());
  menu?.addEventListener('close', () => openBtn?.focus());
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => menu.close()));
  window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => e.matches && menu?.close());

  // Detecta se a barra está sobre uma seção escura para trocar o tom do vidro.
  const darkBg = ['bg-preto', 'bg-verde'];
  let ticking = false;
  const update = () => {
    ticking = false;
    if (!header) return;
    const y = header.getBoundingClientRect().bottom - 20;
    const el = document
      .elementsFromPoint(window.innerWidth / 2, y)
      .find((node) => !header.contains(node) && node.closest('section, footer'));
    const block = el?.closest('section, footer');
    header.classList.toggle('is-dark', !!block && darkBg.some((c) => block.classList.contains(c)));
  };
  const onScroll = () => {
    if (!ticking) {
      ticking = true;
      requestAnimationFrame(update);
    }
  };
  update();
  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', onScroll);
</script>
